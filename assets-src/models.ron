            lod_triangles: (1400, 600, 250, 100),
        ),
        (
            name: "Bone Pikes",
            source: "shared:quaternius/ultimate-monsters/Big/glTF/Orc_Skull.gltf",
            height: 1.2,
            team: ["#738636", "#8b3d5e", "#3b7942"],
            clips: {
                "Idle": "Idle", "Walk": "Walk", "Run": "Run", "Attack": "Weapon",
                "Attack2": "Punch", "Hit": "HitReact", "Die": "Death", "Cheer": "Yes",
                "Block": "Duck",
