        // Conquest's gathering spots, drawn where the economy's nodes are
        // (not placed by land): a Grub seep and a Marrow vein.
        (name: "grub-seep", source: "shared:grubcraft/scenery/grub-seep/grub-seep.glb", family: "rock", sway: 0.0),
        (name: "marrow-vein", source: "shared:grubcraft/scenery/marrow-vein/marrow-vein.glb", family: "rock", sway: 0.0),
    ],
