// Conquest openings (docs/18-ai.md, "Steward: economy and production"): how
// a computer player spends its first minutes, like a player's build order.
// Embedded in the game by gc_ai; only the host's AI reads them, so they are
// not part of the hashed game data and can be tuned freely.
//
// Each match a mind picks one of its personality's openings at random; a
// Warlord picks one that does well against the factions it faces. A Recruit
// always plays Steady. Steady lasts no time at all: it is the usual rules,
// which its numbers spell out.
//
//   who            the personalities that play it (empty: every one)
//   workers_first  workers it has before its first production building
//   producers      production buildings it puts up early: the first at
//                  workers_first, the others whatever its worker count
//   worker_cap     most workers while the opening lasts (None: as many as
//                  its seeps take)
//   expand_at      minute from which it takes one more base, seeps full
//                  or not (None: when they are full, or run low)
//   towers         defence towers it puts up by its hall
//   first_wave     supply its first attack sets out with (None: the usual
//                  wave)
//   minutes        how long the opening lasts; after it, the usual rules
//   against        factions it does well against, for the Warlord
[
    (
        name: "Steady",
        summary: "Workers, one production building, and an army before anything else",
        who: [],
        workers_first: 6,
        producers: 1,
        worker_cap: None,
        expand_at: None,
        towers: 0,
        first_wave: None,
        minutes: 0,
        against: [],
    ),
    (
        name: "Early pressure",
        summary: "Two production buildings on few workers and a small first wave, before you are set up",
        who: ["The Red Banner", "The Hungering", "The Dissonance"],
        workers_first: 5,
        producers: 2,
        worker_cap: Some(10),
        expand_at: None,
        towers: 0,
        first_wave: Some(10),
        minutes: 7,
        against: [Choir],
    ),
    (
        name: "Fast expansion",
        summary: "A second base at two minutes, betting nobody comes early",
        who: ["The Deep Hive", "The Grand Chord", "The Auditor", "The Hungering"],
        workers_first: 6,
        producers: 1,
        worker_cap: None,
        expand_at: Some(2),
        towers: 0,
        first_wave: None,
        minutes: 8,
        against: [EmberClans, CarrionConcord],
    ),
    (
        name: "Walls first",
        summary: "Two towers by the hall, then a slower, safer build",
        who: ["The Iron Lord", "The Grand Chord", "The Long Ledger", "The Auditor"],
        workers_first: 6,
        producers: 1,
        worker_cap: None,
        expand_at: None,
        towers: 2,
        first_wave: None,
        minutes: 8,
        against: [EmberClans],
    ),
]
