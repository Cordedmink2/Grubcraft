// The Guide's class counters: the multipliers of docs/17-unit-rosters.md
// ("Classes and counters"), as (attacker class, target class, multiplier).
// Unlisted pairs are x1.0. The Guide turns them into the "Strong against" and
// "Weak against" lines of a troop's card. The table is a design table: the
// battle code does not apply all of it yet (docs/05-combat.md).
//
// The docs write one column for "Artillery / Siege"; here it is two rows.
// `blurb` is one line on what the class is for.
(
    classes: [
        (name: "Worker", blurb: "Gathers and builds."),
        (name: "Light", blurb: "Fast, fragile infantry and swarms."),
        (name: "Spear", blurb: "Spear and pike lines, the answer to cavalry: brace them, keep them deep."),
        (name: "Heavy", blurb: "Armoured and elite infantry."),
        (name: "Ranged", blurb: "Archers, crossbows, beams and acid. Fog, rain and night cut their reach: the top bar says how much."),
        (name: "Cavalry", blurb: "Riders and fast shock units: a charge ploughs through thin lines and flanks, best downhill; mud stops it."),
        (name: "Air", blurb: "Flying regiments."),
        (name: "Artillery", blurb: "Long-range area fire."),
        (name: "Siege", blurb: "Built to break structures."),
        (name: "Support", blurb: "Economy and aura units."),
        (name: "Monster", blurb: "One huge model that causes terror."),
    ],
    multipliers: [
        ("Light", "Heavy", 0.8),
        ("Light", "Ranged", 1.2),
        ("Light", "Artillery", 1.3),
        ("Light", "Siege", 1.3),
        ("Light", "Worker", 1.2),
        ("Spear", "Heavy", 0.8),
        ("Spear", "Cavalry", 1.5),
        ("Spear", "Monster", 1.2),
        ("Heavy", "Light", 1.4),
        ("Heavy", "Spear", 1.2),
        ("Heavy", "Monster", 0.8),
        ("Ranged", "Light", 1.2),
        ("Ranged", "Spear", 1.2),
        ("Ranged", "Heavy", 1.2),
        ("Ranged", "Cavalry", 0.8),
        ("Ranged", "Monster", 1.3),
        ("Cavalry", "Spear", 0.7),
        ("Cavalry", "Ranged", 1.4),
        ("Cavalry", "Artillery", 1.5),
        ("Cavalry", "Siege", 1.5),
        ("Cavalry", "Worker", 1.3),
        ("Air", "Ranged", 1.2),
        ("Air", "Artillery", 1.5),
        ("Air", "Siege", 1.5),
        ("Air", "Worker", 1.5),
        ("Artillery", "Light", 1.3),
        ("Artillery", "Spear", 1.3),
        ("Artillery", "Heavy", 1.3),
        ("Artillery", "Cavalry", 0.7),
        ("Monster", "Light", 1.4),
        ("Monster", "Spear", 1.2),
        ("Monster", "Heavy", 1.2),
        ("Monster", "Ranged", 1.2),
    ],
)
