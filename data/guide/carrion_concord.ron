// Guide text for the Carrion Concord. Format and rules: see ember_clans.ron.
(
    faction: CarrionConcord,
    buildings: [
        (
            name: "Counting House",
            summary: "Your starting base. It trains Ledger Clerks and Caravans, receives the Marrow your Clerks mine, and is where caravan routes start. It is Fortified. Upgrade it to the Exchange for undead heavies, cavalry, wraiths and a second hero. Workers clear woods and scrub (S) to make room; cleared ground is open.",
            notes: [
                ("Exchange", "The mid game: Gravewardens, Debt Collectors, Lantern Wraiths and a second hero. It costs Marrow, so put Clerks on a vein first."),
            ],
            tips: [
                (icon: Marrow, text: "Keep Ledger Clerks on the nearest Marrow vein so each trip back to this building stays short."),
                (icon: Grub, text: "Send Caravans out from here, since Grub only comes in through trade routes."),
                (icon: Hammer, text: "Upgrade to the Exchange once Marrow is banked, since that upgrade costs 100 Marrow."),
            ],
        ),
        (
            name: "Exchange",
            summary: "The Counting House's second tier. It keeps working while it upgrades, raises your supply cap and unlocks the Lantern Spire and every tier-2 regiment. Upgrade again for the siege engine and the Insolvent when your trade is paying.",
            notes: [
                ("Grand Bourse", "The late game: the Mausoleum Engine, the Insolvent, the third hero and the top upgrades (not designed yet). Expensive, so upgrade once trade and Tithe fund it."),
            ],
            tips: [
                (icon: Hammer, text: "Upgrade while it keeps working, so training and trade do not stop during the upgrade."),
                (icon: Supply, text: "Upgrade before supply runs short, since this raises your cap from 12 to 22."),
                (icon: Hammer, text: "Then build the Lantern Spire, which this tier unlocks, for Lantern Wraiths."),
            ],
        ),
        (
            name: "Grand Bourse",
            summary: "The final tier of the main building. It raises the supply cap again, lets the Ossuary raise the Mausoleum Engine and the Insolvent, and opens the third hero slot. Nothing is left to upgrade, so spend on armies and trade.",
            notes: [],
            tips: [
                (icon: Supply, text: "Save for this upgrade before the late army; it raises your supply cap to 32."),
                (icon: Sword, text: "Then raise the Mausoleum Engine and Insolvent at the Ossuary for your late-game push."),
                (icon: Sword, text: "Hire your third hero at the Vault of Names now that this tier opens the slot."),
            ],
        ),
        (
            name: "Waystation",
            summary: "Your own trade post for caravan routes, paying at half rate, and a Marrow drop-off for expansions. Build one far from your Counting House so caravans earn on long routes and Clerks have a short walk home.",
            notes: [],
            tips: [
                (icon: Grub, text: "Place it far from your Counting House, since caravan pay grows with route length."),
                (icon: Marrow, text: "Use it as a Marrow drop-off when you expand, so Clerks walk less on new patches."),
                (icon: Alarm, text: "Guard the route to it, since a destroyed Caravan drops half its cargo."),
            ],
        ),
        (
            name: "Tenement",
            summary: "Housing: every regiment uses supply, and each Tenement raises the cap. Cheap and quick to raise, so build one before you hit the cap, and keep them behind the front line.",
            notes: [],
            tips: [
                (icon: Supply, text: "Build one before you reach the cap; each adds 10 supply and goes up quickly."),
                (icon: Alarm, text: "Place them behind your front line, so raiders must get past your army to reach them."),
                (icon: Grub, text: "Keep a spare Tenement ready as cheap insurance, since each costs only 80 Grub."),
            ],
        ),
        (
            name: "Reliquary",
            summary: "Every model that dies within 12 tiles, on any side, pays you 1 Tithe. Small, cheap and buildable anywhere you have vision, so plant it beside other people's fights. Your own undead crumble away from Reliquaries, so keep them clear of your army.",
            notes: [],
            tips: [
                (icon: Flag, text: "Plant it near fights you can see; every death within 12 tiles pays you Tithe."),
                (icon: Alarm, text: "Build it on a flank, and keep your undead out of its range, since they crumble nearby."),
                (icon: Grub, text: "Spend the Tithe it earns on Hire Militia or Raise the Bound for quick help."),
            ],
        ),
        (
            name: "Ossuary",
            summary: "Raises the undead: Bone Pikes and Gravewardens, and at tier 3 the Mausoleum Engine and the Insolvent. Undead never rout, so this is your steady frontline. Build it first among military buildings; Bone Pikes need no Marrow.",
            notes: [],
            tips: [
                (icon: Spear, text: "Open with Bone Pikes, since they cost only Grub and make a steady line from the start."),
                (icon: Sword, text: "Add Gravewardens as a line anchor later, and screen them from enemy archers and monsters."),
                (icon: Hammer, text: "Get the Grand Bourse before the Mausoleum Engine or Insolvent, since both need it."),
            ],
        ),
        (
            name: "Guildhall",
            summary: "Trains your living troops: Crossbow Auditors and Debt Collectors. Living regiments reinforce near it. Build it beside the Ossuary so crossbows shoot over your undead pikes, and so cavalry can punish a stalled enemy.",
            notes: [],
            tips: [
                (icon: Heart, text: "Send wounded living regiments back here to reinforce, since they refill near this building."),
                (icon: Bow, text: "Mass Crossbow Auditors against heavies and cavalry; their bolts add 30% against both."),
                (icon: Sword, text: "Send Debt Collectors to raid enemy structures, but keep them away from enemy spears."),
            ],
        ),
        (
            name: "Lantern Spire",
            summary: "Trains Lantern Wraiths, the Concord's flyers. Tier 2 and needs Marrow. Build one to scout, to harass archers and artillery, or to unnerve a line with the Wraiths' Dread Light.",
            notes: [],
            tips: [
                (icon: Flag, text: "Send Lantern Wraiths ahead to scout, since they are fast flyers that never rout."),
                (icon: Bow, text: "Harass archers and artillery with Wraiths, but pull back from enemy archers and flyers."),
                (icon: Alarm, text: "Fly Wraiths into a stalled line, since Dread Light drains morale from enemies within 8 tiles."),
            ],
        ),
        (
            name: "Tollgate",
            summary: "Two crossbows that shoot ground and air (siege engines first, then whoever attacks your buildings, then the nearest; right-click an enemy with it selected to pick its target), and every 4 damage they deal earns you 1 Grub. It is Fortified. Build one at your seeps and gates: it pays for itself while it kills, but it will not stop a real army.",
            notes: [],
            tips: [
                (icon: Grub, text: "Build it at seeps and gates where enemies pass, so its shots earn Grub while it fights."),
                (icon: Alarm, text: "Use it as an early warning and anti-air post, since it shoots both ground and air."),
                (icon: Hammer, text: "Pair it with a real army, since it earns Grub while it fights but will not hold alone."),
            ],
        ),
        (
            name: "Vault of Names",
            summary: "Hires and revives heroes: the Magnate, the Undertaker and the Usurer. Build it early; the Magnate pays for itself and the Undertaker multiplies your dead. Heroes cost Marrow, so keep some in reserve for a replacement.",
            notes: [],
            tips: [
                (icon: Grub, text: "Hire the Magnate for economy; Bribe pays Grub to pacify creep camps nearby."),
                (icon: Sword, text: "Hire the Undertaker to fight where bodies fall, since it raises Bound Dead from corpses."),
                (icon: Heart, text: "Keep Marrow in reserve for a replacement hero, since heroes cost Marrow here."),
            ],
        ),
        (
            name: "Bone Fence",
            summary: "A wall you draw: click the start, move, click the end; click again to bend it, right-click to finish. Shift locks 15-degree steps; O draws a closed ring; B plans a blueprint. Priced and built a tile at a time by a worker.",
            notes: [
                ("Ossuary Wall", "Twice and a half as tough: worth it on any stretch the living will test."),
            ],
            tips: [
                (icon: Alarm, text: "Close a choke point end to end, since regiments file through a gap just one tile wide."),
                (icon: Hammer, text: "B plans it as a blueprint: workers pay tile by tile when you press A or right-click the blue tiles."),
                (icon: Move, text: "Press O to ring your base: it leans on cliffs and marks where an Iron Gate would suit."),
            ],
        ),
        (
            name: "Ossuary Wall",
            summary: "Level 2 of the Bone Fence: stacked bone bound in iron, 2.5 times as tough. Select a Bone Fence and press U: the joined stretch is paid now and a worker raises it a tile at a time while it stays up.",
            notes: [
                ("Mausoleum Wall", "The Concord's toughest wall: four times a Bone Fence. Needs tier 2."),
            ],
            tips: [
                (icon: Flag, text: "Right-click it with foot or archers to man it: they shoot further and take half from arrows."),
                (icon: Hammer, text: "Select the wall and press U: the joined stretch is paid now, then raised a tile at a time."),
                (icon: Alarm, text: "Raise the side facing the enemy first; it stays standing while workers raise it."),
            ],
        ),
        (
            name: "Mausoleum Wall",
            summary: "Level 3, the top: a lantern-lit wall of burial niches, 4 times as tough as a Bone Fence. Needs tier 2. Select an Ossuary Wall and press U to raise its stretch. Its twist: every soldier who dies near it, friend or foe, mends it by 15.",
            notes: [],
            tips: [
                (icon: Flag, text: "Right-click it with foot or archers to man it: they shoot further and take half from arrows."),
                (icon: Alarm, text: "Right-click an enemy raised wall with foot or archers to climb it; spears stop climbers."),
                (icon: Grub, text: "Each tile costs 20 Grub and 5 Marrow, paid for the whole stretch up front."),
            ],
        ),
        (
            name: "Iron Gate",
            summary: "A gate in your Bone Fence: your side walks through and enemies don't. Select it to set Auto (opens as your regiments march up, shuts 2 s after; troops in the gateway hold it open), Locked (shut to everyone) or Open (anyone can pass).",
            notes: [
                ("Gate of Debts", "Half as tough again, with a walk on top for archers or foot. It goes up on its own, with no worker, and the bars keep working."),
            ],
            tips: [
                (icon: Flag, text: "Select it, then Q, W or E: Auto, Locked or Open. Lock it under attack; open it for a sally."),
                (icon: Hammer, text: "Place it on your own Bone Fence and it replaces that stretch: R turns it to run along the wall."),
                (icon: Hammer, text: "Press V to raise it to a Gate of Debts: archers or foot can man its top."),
            ],
        ),
        (
            name: "Gate of Debts",
            summary: "Level 2 of the Iron Gate: an arch of stacked bone and ledger-stones with a walk on top, half as tough again. Select an Iron Gate and press V: it goes up on its own, with no worker, and the bars keep working. Archers or foot can man the walk, and it joins a raised wall beside it into one walkway.",
            notes: [],
            tips: [
                (icon: Flag, text: "Alt+right-click it with foot or archers to man it: they shoot further, take half from arrows."),
                (icon: Alarm, text: "Enemies can climb it on ladders; spears stop climbers. Lock the bars under attack."),
                (icon: Move, text: "A raised wall touching it joins its walk, so one regiment can hold both."),
            ],
        ),
        (
            name: "Bone Causeway",
            summary: "A causeway of bone piers and boards you draw straight across a river: click the near bank, then the far bank. Workers build it out from the bank a span at a time, and anyone can cross it. Break a tile and the troops on it fall into the river, hurt and in disorder, and wash up on the nearest bank.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it straight along x or y, with dry land at both ends and water between."),
                (icon: Move, text: "A worker builds it from the bank and carries on across the river a tile at a time."),
                (icon: Alarm, text: "Enemies can cross it too, so guard it. A tile that falls drops troops into the river."),
            ],
        ),
        (
            name: "Bone Stakes",
            summary: "A line of sharpened bone stakes you draw like a wall, at any angle, for 4 Grub a tile. Anyone walks through at half pace, but nobody charges through: enemy riders and beasts that run onto it are stopped dead, hurt and disordered. It wears down each time.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it like a wall, at any angle. It costs little and goes up fast."),
                (icon: Spear, text: "Spearmen and archers can plant a free line with Plant stakes (C): stand 10 s."),
                (icon: Alarm, text: "Ranks that charge into it are stopped dead; keep your own charges off it."),
            ],
        ),
        (
            name: "Coffin Barricade",
            summary: "A line of stacked coffins you draw like a wall, for 8 Grub a tile. It blocks walking like a wall, and your troops within 2 tiles of it take 30 percent less from arrows and 20 percent less from blows to their front. Enemy troops get no cover from it.",
            notes: [],
            tips: [
                (icon: Hammer, text: "Draw it like a wall, at any angle. It costs little and goes up fast."),
                (icon: Bow, text: "Put your archers and spears within 2 tiles behind it to take the cover."),
                (icon: Alarm, text: "It blocks your own troops too, so leave a gap where your line must pass."),
            ],
        ),
    ],
    units: [
        (
            name: "Ledger Clerk",
            tagline: "Worker: mines Marrow, builds and repairs.",
            summary: "The Concord's worker. Carries 5 Marrow per trip to a Counting House (your Grub comes from caravans, Tithe and trade), and builds and repairs Concord structures. Weak fighters, so keep them out of raids. They can also clear woods, scrub and thicket (S). Clerks burn it: twice as fast as other workers, but it pays no timber.",
        ),
        (
            name: "Caravan",
            tagline: "Support: shuttles to trade posts for Grub.",
            summary: "A slow, sturdy cart. Trade Run shuttles between your Counting House and a trade post, paying Grub per delivery that grows with the route (full rate at a hamlet or an ally, half at a Waystation). Guard it; a destroyed Caravan drops half its cargo.",
        ),
        (
            name: "Bone Pikes",
            tagline: "Undead spear line: never routs, no Marrow.",
            summary: "Cheap undead pikemen who never rout and need no Marrow. Reach and Pike Wall stop cavalry cold. They crumble away from Reliquaries and lose to heavy infantry and archers, so support them with Crossbow Auditors. Your general drives those near him to strike harder; if he falls they falter. Your opening line.",
        ),
        (
            name: "Crossbow Auditors",
            tagline: "Crossbows: bolts pierce Heavy and Cavalry.",
            summary: "Living crossbowmen. Audit adds 30% damage against Heavy and Cavalry, so they counter exactly what spears cannot. They are fragile in melee and rout normally, so stand them behind your undead pikes.",
        ),
        (
            name: "Gravewardens",
            tagline: "Undead heavy infantry: shielded, never routs.",
            summary: "Shielded undead heavies. Unfeeling reduces the damage of flank and rear hits, and they never rout. They beat light infantry and spears but fear archers and monsters, and they crumble near Reliquaries. A tier-2 anchor.",
        ),
        (
            name: "Debt Collectors",
            tagline: "Cavalry: steal Grub from structures they hit.",
            summary: "Heavy living cavalry with a big charge. Repossess steals 1 Grub for every 2 damage dealt to a structure, so raiding pays for itself. Strong against archers and artillery; spears stop them. Needs Marrow.",
        ),
        (
            name: "Lantern Wraiths",
            tagline: "Undead flyers: Dread Light drains enemy morale.",
            summary: "Fast undead flyers that never rout. Their Dread Light aura drains 1.5 morale a second from nearby enemies, so a few Wraiths over a fight can break a line. Archers and other flyers answer them; they crumble near Reliquaries.",
        ),
        (
            name: "Mausoleum Engine",
            tagline: "Siege: long-range, raises Bound Dead from corpses.",
            summary: "A tier-3 siege engine. It shoots from 40 tiles, deals triple damage to Fortified structures, and Interment raises corpses nearby as Bound Dead for 30 seconds. Slow and never routs. Cavalry and flyers kill it if unescorted.",
        ),
        (
            name: "The Insolvent",
            tagline: "Monster: heals on corpses, terror aura.",
            summary: "A stitched-together tier-3 monster. It regains health for each corpse it walks over and its Terror Aura bleeds enemy morale within 10 tiles. Never routs. Focused ranged fire and heroes bring it down; best used after the fight has made corpses.",
        ),
        (
            name: "Bound Dead",
            tagline: "Summoned undead: raised from corpses, never rout.",
            summary: "Raised by Raise the Bound, Indenture, Raise Dead, Interment and Mass Grave. Light undead who never rout and cost no supply. Temporary ones fade in 30 to 90 seconds; Indentured ones crumble instead. Cannot be trained.",
        ),
        (
            name: "Grubfolk Militia",
            tagline: "Hired spearmen: leave after 120 s.",
            summary: "Spearmen hired from a hamlet with Hire Militia. They cost no supply and leave after 120 seconds, or at once if their hamlet is razed. A quick stopgap spear line when cavalry surprises you; they cannot be trained at a building.",
        ),
        (
            name: "The Magnate",
            tagline: "Hero of economy: banks interest, bribes, raids income.",
            summary: "An economy hero. Hostile Takeover claims a hamlet as your exclusive trade post, Bribe pacifies a creep camp for Grub, and Compound Interest earns a share of your banked Grub. Market Crash halves every enemy's income. Stay out of fights.",
        ),
        (
            name: "The Undertaker",
            tagline: "Hero necromancer: raises the dead, bursts corpses.",
            summary: "A necromancer. Raise Dead makes Bound Dead from corpses, Corpse Explosion bursts them for damage, and Last Rites heals an undead regiment and restores models. Mass Grave raises every model that dies in an area on your side. Fight where bodies fall.",
        ),
        (
            name: "The Usurer",
            tagline: "Hero duelist: drains health, marks targets, steals buffs.",
            summary: "A debuffing duelist. Leech Debt drains a target's health into him, Lien marks a regiment to take more damage, Collateral steals a beneficial effect, and Foreclosure strips a weakened regiment of its weakest third. Pick off wounded regiments and enemy heroes.",
        ),
    ],
)
